# ──────────────────────────────────────────────
# CourseSync — Environment Configuration
# Copy this file to .env and fill in your keys.
# ──────────────────────────────────────────────

# Firecrawl
FIRECRAWL_API_KEY=

# LLM — Nemotron (NVIDIA NIM, OpenAI-compatible)
NEMOTRON_API_KEY=
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b

# LLM — Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Database
DATABASE_URL=sqlite:///./data/coursesync.db

# App
APP_ENV=development
LOG_LEVEL=INFO

# LLM Provider (nemotron | gemini)
LLM_PROVIDER=gemini
